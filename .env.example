# Copy to .env (gitignored) and fill in YOUR OWN values. Never commit .env.
# The site itself needs no secrets. These are only for agents working on the repo.
GITHUB_TOKEN=          # classic token, public_repo scope only, named grok-ashandoaktree, 90-day expiry
XAI_API_KEY=           # if your Grok agent needs one
ANTHROPIC_API_KEY=     # if your Claude agent needs one
